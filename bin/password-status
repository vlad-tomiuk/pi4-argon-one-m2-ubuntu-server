#!/usr/bin/env bash
# password-status — health overview of the self-hosted Vaultwarden instance.
#
# Usage:  password-status        full report
#         password-status -q     no output, exit code only: 0 = healthy, 1 = problem
#
# Read-only: only the DOMAIN line of .env is read, never ADMIN_TOKEN.

[ "${1:-}" = "-q" ] && QUIET=1
UI=${PI_UI:-/usr/local/lib/pi-server/ui.sh}
[ -r "$UI" ] || UI="$(dirname "$(readlink -f "$0")")/lib/ui.sh"
if [ ! -r "$UI" ]; then
    echo "Немає бібліотеки оформлення ui.sh."
    echo "Встанови команди заново:  sudo bash /opt/pi-server/scripts/install-commands.sh"
    exit 1
fi
# shellcheck source=lib/ui.sh
. "$UI"

APP=${VAULTWARDEN_DIR:-/srv/apps/vaultwarden}
PORT=${VAULTWARDEN_PORT:-8080}

cd "$APP" 2>/dev/null || { echo "password-status: $APP не знайдено"; exit 1; }

URL=$(grep -m1 '^DOMAIN=' .env 2>/dev/null | cut -d= -f2-)

title "VAULTWARDEN" "менеджер паролів"

if [ -n "$URL" ]; then
    row info "Адреса" "${B}${URL}${N}"
    row info "Адмінка" "${DIM}${URL}/admin${N}"
else
    row warn "Адреса" "не задана в .env"
fi
hr

STATUS=$(docker ps --filter name=vaultwarden --format '{{.Status}}' 2>/dev/null)
if [ -n "$STATUS" ]; then
    row ok   "Контейнер" "$STATUS"
else
    row fail "Контейнер" "не запущений — docker compose up -d"
fi

# Local check proves the app itself is alive, independently of Tailscale.
if curl -sf -m 5 -o /dev/null "http://127.0.0.1:${PORT}/alive"; then
    row ok   "Локально" "відповідає на 127.0.0.1:${PORT}"
else
    row fail "Локально" "немає відповіді — docker compose logs --tail 30"
fi

if tailscale serve status 2>/dev/null | grep -q "127.0.0.1:${PORT}"; then
    row ok   "Tailscale" "проксі активний"
else
    row fail "Tailscale" "не налаштований — sudo tailscale serve --bg ${PORT}"
fi

# The path a phone or browser actually takes.
if [ -n "$URL" ]; then
    CODE=$(curl -s -m 10 -o /dev/null -w '%{http_code}' "$URL/alive" 2>/dev/null)
    if [ "$CODE" = "200" ]; then
        row ok   "HTTPS ззовні" "сертифікат дійсний"
    else
        row fail "HTTPS ззовні" "код ${CODE:-—}, перевір tailscale status"
    fi
fi

# Signups must stay closed once your account exists.
if [ -n "$STATUS" ]; then
    SIGNUPS=$(docker exec vaultwarden printenv SIGNUPS_ALLOWED 2>/dev/null)
    case "$SIGNUPS" in
        false|"") row ok   "Реєстрація" "закрита" ;;
        *)        row warn "Реєстрація" "ВІДКРИТА — docker compose up -d --force-recreate" ;;
    esac
fi

# MemUsage looks like "16.32MiB / 7.618GiB" — keep the used part only.
STATS=$(docker stats --no-stream --format '{{.CPUPerc}}|{{.MemUsage}}' vaultwarden 2>/dev/null)
if [ -n "$STATS" ]; then
    MEM=${STATS#*|}
    row info "Ресурси" "${STATS%%|*} CPU, ${MEM%% *} RAM"
fi

DATA=$APP/data
[ -d "$DATA" ] && row info "Дані" "${DIM}$DATA ($(du -sh "$DATA" 2>/dev/null | cut -f1))${N}"

# A vault without a fresh backup is one dead SSD away from being gone.
LAST=$(ls -1t /srv/backup/vaultwarden/*.tar.gz 2>/dev/null | head -1)
if [ -n "$LAST" ]; then
    AGE=$(( ( $(date +%s) - $(stat -c %Y "$LAST") ) / 86400 ))
    DESC="$(date -r "$LAST" '+%F %H:%M'), $(du -h "$LAST" | cut -f1)"
    if [ "$AGE" -le 2 ]; then row ok "Бекап" "$DESC"; else row warn "Бекап" "$DESC — $AGE дн. тому"; fi
else
    row warn "Бекап" "не налаштований — docs/backups.md"
fi

verdict "Все працює" "Є проблеми — дивись рядки з ✖"
