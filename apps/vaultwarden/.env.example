# Скопіюй у .env і заповни. Файл .env у git не потрапляє.

# Адреса в Tailscale. Дізнатися: tailscale status --json | grep DNSName
# або в адмінці https://login.tailscale.com/admin/machines
DOMAIN=https://vault.ІМ_Я_ТВОЄЇ_МЕРЕЖІ.ts.net

# Хеш пароля для панелі адміністратора (/admin).
# Згенерувати: docker run --rm -it vaultwarden/server /vaultwarden hash
#
# УВАГА: кожен символ $ треба подвоїти ($$), інакше docker compose вважатиме
# його початком змінної і зіпсує хеш. Тобто замість
#   $argon2id$v=19$m=65540,t=3,p=4$...
# пишемо
#   $$argon2id$$v=19$$m=65540,t=3,p=4$$...
# Зробити це автоматично (встав хеш, коли запитає):
#   read -rsp 'Хеш: ' H; echo; printf 'ADMIN_TOKEN=%s\n' "${H//\$/\$\$}" >> .env
ADMIN_TOKEN=
