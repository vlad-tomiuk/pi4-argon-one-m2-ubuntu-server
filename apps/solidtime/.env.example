# Скопіюй у .env і заповни. Файл .env у git не потрапляє.
#
# solidtime має власне ім'я через Tailscale Services (як Linkwarden).
# Створення сервісу описане в docs/timetracking.md.

# Публічна адреса — рівно та, яку відкриватимеш у браузері, без / у кінці
APP_URL=https://time.ІМ_Я_МЕРЕЖІ.ts.net

# Пароль бази: openssl rand -base64 24  (без символів $ і ', щоб не екранувати)
DB_PASSWORD=

# Email-и через кому, яким відкрита адмін-панель /admin (необов'язково)
SUPER_ADMINS=

# APP_KEY, PASSPORT_PRIVATE_KEY і PASSPORT_PUBLIC_KEY сюди НЕ вписуй вручну:
# команда з docs/timetracking.md згенерує їх і допише в кінець файлу.
