# Скопіюй у .env і заповни. Файл .env у git не потрапляє.
#
# Linkwarden не працює на підшляху, тому має власне ім'я через Tailscale Services.
# Створення сервісу описане в docs/bookmarks.md.

# Публічна адреса — рівно та, яку відкриватимеш у браузері
NEXTAUTH_URL=https://links.ІМ_Я_МЕРЕЖІ.ts.net/api/v1/auth

# Ключ для підпису сесій: openssl rand -base64 32
NEXTAUTH_SECRET=

# Пароль бази: openssl rand -base64 24  (без символів $ і ', щоб не екранувати)
POSTGRES_PASSWORD=

# Реєстрація. Перший запуск — true, щоб створити свій акаунт,
# одразу після цього міняємо на true → false і перезапускаємо.
NEXT_PUBLIC_DISABLE_REGISTRATION=false
